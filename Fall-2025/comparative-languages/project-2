; helper function for set-equal
; checks if a set contains a certain number
(define (contains? set num)
  (not (not (member num set)))) ; have to use weird double-not to turn return value to strict t/f

; set-equal?
; takes two lists as input
; returns true if the sets are equal
; returns false otherwise
(define (set-equal? set1 set2)
  ; uses an 'and' operator to return logical 'and' of two for loops
  (and (for/and ([i set1]) ; iterates over every element in set1
         (contains? set2 i)) ; if that element is not in set2, returns false
  (for/and ([i set2]) ; same logic as above but vice versa
    (contains? set1 i)))
  )

; nested-set-equal?
; takes two lists as input that can contain nested sets
; returns true if the sets are equal
; returns false otherwise
(define (nested-set-equal? set1 set2)

  ; recursively checks if x is a member of set lst
  (define (member-list? x lst)
    (for/or ([y lst]) (nested-set-equal? x y))) ; iterates over the list and returns #t if x is member of lst

  ; checks if set 'a' is a subset of set 'b'
  (define (subset? a b)
    (for/and ([x a]) (member-list? x b))) ; iterates over set and check if each element is a member of other set

  ; returns #t for whole function if both sets are subsets of each other
  ; returns #f otherwise
   (and (subset? set1 set2) (subset? set2 set1)))
   
  
  


; TEST CASES
(set-equal? '(1 2 3 4) '(4 2 1 3))
(set-equal? '() '(4 2))
(nested-set-equal? '(1 2 (3 4 5)) '(2 (4 3 5) 1))
(nested-set-equal? '(1 (3 4 5)) '((3 5) 1))
(nested-set-equal? '(1 (3 4 5)) '(2 (4 3 5) 1))